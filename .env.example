# Database (dev: docker compose, host port 5433)
POSTGRES_USER=agrect
POSTGRES_PASSWORD=agrect_dev
POSTGRES_DB=agrect
DATABASE_URL=postgresql+psycopg://agrect:agrect_dev@localhost:5433/agrect
# API
# Generate: 64 random hex characters. The API refuses to start with less than 32.
JWT_SECRET=CHANGE_ME
CORS_ORIGINS=http://localhost:5173
# Demo farm: placeholder until real coordinates are given. Never hard-code.
DEMO_FARM_LAT=
DEMO_FARM_LON=
DEMO_FARM_TZ=Africa/Algiers
JWT_EXPIRE_MIN=720
DEMO_USER_EMAIL=demo@agrect.app
DEMO_USER_PASSWORD=change-me-demo
DEMO_FARM_NAME=Demo farm
# Open-Meteo forecast endpoint (no API key). Override in tests; do not call it from pytest.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Open-Meteo archive (reanalysis). Tests must not call it.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# Past years of daily history stored per farm (1–30).
HISTORY_YEARS=10
# Background jobs (weather refresh, nightly derive, history, maintenance). One process runs them.
JOBS_ENABLED=false
